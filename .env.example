# Required for Docker Compose. Generate a long random value before starting.
YTGO_AUTH_TOKEN=

YTGO_BIND_ADDRESS=127.0.0.1
YTGO_PORT=8080
YTGO_EXTERNAL_URL=
YTGO_CORS_ORIGIN=
TZ=Asia/Shanghai

# Container resource limits
YTGO_CPU_LIMIT=2.0
YTGO_MEMORY_LIMIT=2g
YTGO_PIDS_LIMIT=256

